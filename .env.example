# Database
DATABASE_URL=postgresql://user:password@host:5432/backupr

# Object storage (MinIO / S3)
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=backupr

# Web app
API_URL=
WS_URL=

# Auth
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=

# Number of reverse proxies in front of the server that append to
# X-Forwarded-For. compose.yml defaults to 2 (outer proxy + backupr_proxy).
TRUSTED_PROXY_HOPS=

# Email notifications (SMTP). Leave MAIL_HOST empty to disable.
# Example: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USER=you@gmail.com,
# MAIL_PASS=<app password>
MAIL_HOST=
MAIL_PORT=587
# true = SMTPS (implicit TLS). Defaults to true only on port 465; otherwise STARTTLS.
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
# Sender address; falls back to MAIL_USER
MAIL_FROM=
MAIL_FROM_NAME=Backupr
# Public URL of the web app, used for links in emails (e.g. https://backupr.example.com)
APP_URL=

# Browser (Web Push) notifications. Leave empty to disable; in-app toasts still work.
# Generate a keypair once with: bunx web-push generate-vapid-keys
# Changing the keys invalidates every browser's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:admin@example.com
VAPID_SUBJECT=

# Notification tuning
# Days without a successful backup before a job is reported as stale
STALE_AFTER_DAYS=5
# Days between reminders while a job stays stale
STALE_REMINDER_DAYS=2
# Minimum minutes between failure emails for the same job
FAILURE_COOLDOWN_MINUTES=60
# Weekly report: day of the week (0 = Sunday … 6 = Saturday) and local hour (server TZ)
WEEKLY_REPORT_DAY=1
WEEKLY_REPORT_HOUR=8
